# ── Production / Shared Config (.env) ──
DATABASE_URL="postgresql://..."
NEXT_PUBLIC_ORCHESTRATOR_URL="https://yourdomain.com"
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
APP_URL=http://yourdomain.com
PORT=5501
WOO_BASE_URL="https://yourstore.com"
WOO_CONSUMER_KEY="ck_..."
WOO_CONSUMER_SECRET="cs_..."
INTEGRATION_MODE_WOO=rest
INTEGRATION_MODE_HUBSPOT=rest
# Product source switch: choose ONE source for all catalog features
# (search/recommendations/product detail/cross-sell/add-to-cart lookup)
# Allowed values: hubspot | woo
INTEGRATION_PRODUCT_SOURCE=hubspot
# Optional cap for HubSpot catalog fetch size per search call.
# Useful when query="" to load large catalog pages.
HUBSPOT_PRODUCTS_MAX_FETCH=500
HUBSPOT_ACCESS_TOKEN=pat-...
# Optional: dedicated HubSpot token for product reads.
# If set, product catalog calls use this token first.
# Keep HUBSPOT_ACCESS_TOKEN for CRM writes (contacts/deals/carts).
HUBSPOT_PRODUCTS_ACCESS_TOKEN=pat-...

# ── Group Order Configuration (M2) ──
# Default MOQ in surfaces/pallets (משטח) - default: 1
# This is the minimum number of pallets required before checkout
GROUP_ORDER_DEFAULT_MOQ_SURFACES=1

# Allow opening more surfaces than MOQ - default: false
# If false, group order is limited to exactly MOQ surfaces
# If true, can open up to GROUP_ORDER_MAX_SURFACES
GROUP_ORDER_ALLOW_EXTRA_SURFACES=false

# Maximum surfaces allowed when extra surfaces enabled - default: 10
# Only applies when GROUP_ORDER_ALLOW_EXTRA_SURFACES=true
GROUP_ORDER_MAX_SURFACES=10

# Import order MOQ: minimum pallet surfaces for a single-user import order (default: same as GROUP_ORDER_DEFAULT_MOQ_SURFACES)
IMPORT_ORDER_DEFAULT_MOQ_SURFACES=1

# ── Local Dev Overrides (.env.local) ──
# Create .env.local to override for local development:
# NEXT_PUBLIC_ORCHESTRATOR_URL="http://localhost:5502"
# APP_URL=http://localhost:3301
# PORT=5502

# ── Stock Order Configuration (M2) ──
# Default MOQ in boxes (display and copy: "minimum X boxes")
# Default: 3. Used in get_order_type_options and AI messaging.
STOCK_ORDER_DEFAULT_MOQ_BOXES=3
# Optional: minimum total units for cart validation (legacy). If unset, derived from boxes.
# STOCK_ORDER_DEFAULT_MOQ_UNITS=6

# ── M3: Telegram Bot ──
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your bot's username (without the @)
TELEGRAM_BOT_USERNAME=TasteLabsBot
# Optional: set when registering the webhook with Telegram for request verification
TELEGRAM_WEBHOOK_SECRET=