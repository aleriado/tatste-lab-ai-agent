# If using HubSpot REST fallback instead of MCP (not provided in client msg)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_ID=


# Orchestrator base URL (used by web app)
