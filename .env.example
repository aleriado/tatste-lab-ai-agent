# ── Production / Shared Config (.env) ──
DATABASE_URL="postgresql://..."
NEXT_PUBLIC_ORCHESTRATOR_URL="https://yourdomain.com"
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
APP_URL=http://yourdomain.com
PORT=5501
WOO_BASE_URL="https://yourstore.com"
WOO_CONSUMER_KEY="ck_..."
WOO_CONSUMER_SECRET="cs_..."
INTEGRATION_MODE_WOO=rest
INTEGRATION_MODE_HUBSPOT=rest
# Product source switch: choose ONE source for all catalog features
# (search/recommendations/product detail/cross-sell/add-to-cart lookup)
# Allowed values: hubspot | woo
INTEGRATION_PRODUCT_SOURCE=hubspot
# Optional cap for HubSpot catalog fetch size per search call.
# Useful when query="" to load large catalog pages.
HUBSPOT_PRODUCTS_MAX_FETCH=500
HUBSPOT_ACCESS_TOKEN=pat-...
# Optional: dedicated HubSpot token for product reads.
# If set, product catalog calls use this token first.
# Keep HUBSPOT_ACCESS_TOKEN for CRM writes (contacts/deals/carts).
HUBSPOT_PRODUCTS_ACCESS_TOKEN=pat-...

# ── Local Dev Overrides (.env.local) ──
# Create .env.local to override for local development:
# NEXT_PUBLIC_ORCHESTRATOR_URL="http://localhost:5502"
# APP_URL=http://localhost:3301
# PORT=5502
