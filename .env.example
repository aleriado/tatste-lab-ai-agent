DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Integration modes
INTEGRATION_MODE_WOO=rest
INTEGRATION_MODE_HUBSPOT=mcp

# Woo REST (provided by client)
WOO_BASE_URL="https://tastelabs.co.il"
WOO_CONSUMER_KEY=ck_...
WOO_CONSUMER_SECRET=cs_...

# WP MCP (NOT provided yet)
MCP_WP_BASE_URL=
MCP_WP_TOKEN=

# HubSpot MCP OAuth app (provided by client)
HUBSPOT_APP_ID=30397195
HUBSPOT_CLIENT_ID=9ef5a248-...
HUBSPOT_CLIENT_SECRET=8cad28e7-...

# Optional (only if needed by your MCP setup)
