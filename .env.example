DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Integration modes
INTEGRATION_MODE_WOO=rest
# INTEGRATION_MODE_HUBSPOT set in HubSpot section below (rest recommended for write)

# Woo REST (provided by client)
WOO_BASE_URL="https://tastelabs.co.il"
WOO_CONSUMER_KEY=ck_...
WOO_CONSUMER_SECRET=cs_...

# WP MCP (NOT provided yet)
MCP_WP_BASE_URL=
MCP_WP_TOKEN=

# HubSpot — use REST with Private App access token for recommend → add-to-cart → HubSpot write
INTEGRATION_MODE_HUBSPOT=rest
# Private App access token (required for REST mode); EU tokens start with eu1- and use api-eu1.hubapi.com
HUBSPOT_ACCESS_TOKEN=pat-na1-...
# Optional: override API base (auto-set for EU when token starts with eu1-)
# HUBSPOT_BASE_URL=https://api-eu1.hubapi.com
# Optional: default pipeline and stage for new deals
# HUBSPOT_PIPELINE_ID=
# HUBSPOT_STAGE_ID=

# HubSpot MCP OAuth app (only when using INTEGRATION_MODE_HUBSPOT=mcp)
HUBSPOT_APP_ID=30397195
HUBSPOT_CLIENT_ID=9ef5a248-...
HUBSPOT_CLIENT_SECRET=8cad28e7-...


# Orchestrator base URL (used by web app)
ORCHESTRATOR_URL="http://localhost:4000"
NEXT_PUBLIC_ORCHESTRATOR_URL="http://localhost:4000"
