// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// Enums
//

enum Channel {
  web
  whatsapp
  telegram
}

enum ThreadType {
  browse
  cart
  order
  group_order
  support
  suggestion
  generic
}

enum MessageDirection {
  inbound
  outbound
}

enum IdempotencyScope {
  inbound_message
  outbound_message
  payment_intent
  webhook_event
  generic
}

enum IntegrationProvider {
  hubspot
  woocommerce
  whatsapp
  telegram
}

enum IntegrationAuthType {
  api_key
  private_app_token
  oauth2
  mcp
}

enum IntegrationStatus {
  active
  disabled
}

enum GroupOrderStatus {
  DRAFT
  OPEN
  MOQ_REACHED
  EXPIRED
  CHECKOUT_STARTED
  CONFIRMED
}

enum OrderType {
  GROUP  // Multi-user, shared palette
  IMPORT // Single-user, full palette (restaurants, supermarkets)
}

enum CartOrderType {
  REGULAR // Retail / general order
  STOCK   // Wholesale / stock order
}

//
// Core: Customer + Identity
//

model Customer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional stable identifiers (when available)
  email String? @db.VarChar(320)
  phone String? @db.VarChar(64)

  // User preferences & profile (M1-level: lightweight JSON; can normalize later)
  preferencesJson Json? // vegan/kosher/allergies, brand prefs, opt-outs, quiet hours
  profileJson     Json? // derived profile signals, segments, notes

  // Multi-channel continuity
  preferredChannel Channel?
  lastSeenChannel  Channel?
  lastSeenAt       DateTime?

  // “Multiple active flows” support (Gil feedback)
  foregroundThreadId String? @unique
  foregroundThread   Thread? @relation("ForegroundThread", fields: [foregroundThreadId], references: [id])

  // Relations
  identities ChannelIdentity[]
  threads    Thread[]
  messages   Message[]
  crmLinks   CrmLink[]
  commerceLinks CommerceLink[]
  idempotencyKeys IdempotencyKey[]
  cart       Cart?
  groupOrderParticipants GroupOrderParticipant[]
  createdGroupOrders     GroupOrder[] @relation("GroupOrderCreator")

  @@index([email])
  @@index([phone])
}

model ChannelIdentity {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  channel Channel
  // The platform-specific identifier (WhatsApp number, Telegram user id, web cookie/session id, etc.)
  channelUserId String @db.VarChar(256)

  // Optional: metadata about this identity (e.g., display name, language)
  meta Json?

  @@unique([channel, channelUserId])
  @@index([customerId, channel])
}

//
// Threads: allow multiple active flows in parallel
//

model Thread {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type ThreadType @default(generic)

  // Thread “key” lets you route messages to the correct thread.
  // Examples:
  // - "group_order:go_123"
  // - "cart:manufacturer:A"
  // - "order:woo_order_999"
  key String? @db.VarChar(256)

  status String? @db.VarChar(64) // e.g., open/closed/awaiting_payment
  step   String? @db.VarChar(128) // e.g., awaiting_qty, awaiting_address

  // Thread-specific context (entities extracted, cart refs, etc.)
  contextJson Json?

  lastActivityAt DateTime?

  // Relations
  messages Message[]

  // For the foreground reference relation
  foregroundFor Customer? @relation("ForegroundThread")

  @@index([customerId, type])
  @@index([customerId, lastActivityAt])
  @@unique([customerId, key])
}

//
// Messages: audit trail + debugging + summarization input
//

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  channel   Channel
  direction MessageDirection
  text      String? @db.Text

  // Optional: store normalized payload fragments / tool traces safely
  meta Json?

  // Useful for tracing a single request end-to-end
  traceId String? @db.VarChar(64)

  @@index([customerId, createdAt])
  @@index([threadId, createdAt])
  @@index([traceId])
}

//
// Idempotency: required for safe webhooks + retries
//

model IdempotencyKey {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  scope IdempotencyScope
  key   String @db.VarChar(256)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Optional: store response snapshot for replay-safe behavior
  responseJson Json?

  // Optional: basic status
  status String? @db.VarChar(32)

  @@unique([scope, key])
  @@index([customerId, scope])
}

//
// CRM links (HubSpot) + Commerce links (Woo)
// Keep these as external references, not secrets.
//

model CrmLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  provider IntegrationProvider @default(hubspot)

  hubspotPortalId  String? @db.VarChar(64)
  hubspotContactId String? @db.VarChar(64)
  hubspotDealId    String? @db.VarChar(64)

  // You can store pipeline/stage for quick lookup, but HubSpot remains the source of truth
  dealPipelineId String? @db.VarChar(64)
  dealStageId    String? @db.VarChar(64)

  meta Json?

  @@index([customerId, provider])
  @@index([hubspotContactId])
  @@index([hubspotDealId])
}

model CommerceLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  provider IntegrationProvider @default(woocommerce)

  wooCustomerId String? @db.VarChar(64)
  wooCartId     String? @db.VarChar(128)
  wooOrderId    String? @db.VarChar(64)

  meta Json?

  @@index([customerId, provider])
  @@index([wooOrderId])
}

//
// Optional (future-friendly): Integration records
// Useful if later you need multi-tenant OAuth or portal/account metadata.
// For M1 you can create this table but not necessarily use it.
//

model IntegrationAccount {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider IntegrationProvider
  authType IntegrationAuthType
  status   IntegrationStatus @default(active)

  // e.g., HubSpot portal/account id, Woo site identifier, etc.
  accountId String? @db.VarChar(128)

  // IMPORTANT: Do NOT store raw secrets here.
  // If you later implement OAuth, store tokens encrypted, or store references to a secrets manager.
  tokenRef String? @db.VarChar(256) // pointer to AWS Secrets Manager key, etc.

  meta Json?

  @@index([provider, status])
  @@index([accountId])
}

//
// M2: GroupOrder with full lifecycle + strict surface/layer allocation
//

model GroupOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code String @unique @db.VarChar(8) // shareable join code

  createdByCustomerId String
  createdByCustomer   Customer @relation("GroupOrderCreator", fields: [createdByCustomerId], references: [id])

  // Manufacturer constraint (CLIENT RULE 1: one manufacturer per group order)
  manufacturerId String? @db.VarChar(128)

  status GroupOrderStatus @default(DRAFT)
  orderType       OrderType        @default(GROUP)
  isImport        Boolean          @default(false)
  maxParticipants Int?             // null = unlimited (group), 1 = import
  constraintsJson Json?

  // MOQ tracking (CLIENT RULE 7: MOQ in surfaces/pallets, not boxes)
  moqSurfaces      Int @default(1) // from env GROUP_ORDER_DEFAULT_MOQ_SURFACES
  moqTarget        Int @default(1) // DEPRECATED: kept for backward compatibility
  moqCurrent       Int @default(0) // DEPRECATED: kept for backward compatibility
  
  // CLIENT RULE 4: surface_max_layers = MIN(layers_per_surface) across all products
  surfaceMaxLayers Int? // calculated when first product added

  expiresAt DateTime?

  meta Json?

  // Relations
  participants GroupOrderParticipant[]
  items        GroupOrderItem[] // User-level tracking (kept for backward compatibility)
  surfaces     GroupOrderSurface[] // NEW: Surface/layer allocation

  @@index([manufacturerId])
  @@index([status])
  @@index([code])
}

// CLIENT RULE 2: Each surface/pallet has multiple layers
model GroupOrderSurface {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupOrderId String
  groupOrder   GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  surfaceIndex Int // 0-based index (surface 0, 1, 2...)
  maxLayers    Int // snapshot of surface_max_layers at creation time
  status       String @default("open") @db.VarChar(32) // open, full, locked

  layers GroupOrderLayer[]

  @@unique([groupOrderId, surfaceIndex])
  @@index([groupOrderId])
}

// CLIENT RULE 3: One product type per layer
model GroupOrderLayer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  surfaceId String
  surface   GroupOrderSurface @relation(fields: [surfaceId], references: [id], onDelete: Cascade)

  layerIndex Int // 0-based index within surface
  productId  String
  variantId  String?

  // CLIENT RULE 6: Layer capacity from product metadata
  capacityBoxes Int
  capacityUnits Int

  // Current fill (CLIENT RULE 5: fill existing layers first)
  filledBoxes Int @default(0)
  filledUnits Int @default(0)

  status String @default("open") @db.VarChar(32) // open, full

  // Audit: which customers contributed to this layer
  contributions Json? // [{customerId, boxes, units, timestamp}]

  @@unique([surfaceId, layerIndex])
  @@index([surfaceId])
  @@index([productId])
}

model GroupOrderParticipant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  groupOrderId String
  groupOrder   GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  @@unique([groupOrderId, customerId])
  @@index([groupOrderId])
}

model GroupOrderItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupOrderId String
  groupOrder   GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  customerId String // who added this item

  productId  String
  variantId  String?
  name       String
  imageUrl   String?
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int      @default(1)
  metadata   Json?

  @@index([groupOrderId])
  @@index([groupOrderId, customerId])
}

//
// M2: Cart (persistent, replaces contextJson.cart)
//

model Cart {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  currency String @default("ILS")

  items CartItem[]

  @@index([customerId])
}

model CartItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId String
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  variantId String?
  orderType CartOrderType @default(REGULAR)
  name      String
  imageUrl  String?
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)
  metadata  Json?

  @@unique([cartId, productId, variantId, orderType])
  @@index([cartId])
}

//
// M2: Checkout session (mock payment tracking)
//

model CheckoutSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId    String
  groupOrderId  String? // null for individual checkout

  token    String @unique @db.VarChar(64)
  status   String @default("pending") @db.VarChar(32) // pending, paid, failed
  currency String @default("ILS")

  totalAmount    Decimal @db.Decimal(10, 2)
  amountDueNow   Decimal @db.Decimal(10, 2) // 50%
  amountDueLater Decimal @db.Decimal(10, 2) // 50%
  paidAmount     Decimal @default(0) @db.Decimal(10, 2)

  meta Json?

  @@index([customerId])
  @@index([token])
}

// M3: Link codes for cross-channel identity bridging (web → Telegram / WhatsApp)
model LinkCode {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  code       String    @unique @db.VarChar(16)
  customerId String
  usedAt     DateTime?

  @@index([code])
  @@index([customerId])
}
